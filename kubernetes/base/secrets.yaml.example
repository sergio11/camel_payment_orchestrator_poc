# Copy to secrets.yaml (gitignored, NEVER commit real values).
# Prod: inject via ExternalSecrets / SealedSecrets / Vault.
apiVersion: v1
kind: Secret
metadata:
  name: provider-secrets
  namespace: poc-camel
  labels:
    app: poc-camel
    component: secrets
type: Opaque
stringData:
  provider.a.api.key: "REPLACE_ME"
  provider.a.api.secret: "REPLACE_ME"
  provider.b.api.key: "REPLACE_ME"
  provider.b.api.secret: "REPLACE_ME"
  kafka.sasl.username: "REPLACE_ME"
  kafka.sasl.password: "REPLACE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: poc-camel
  labels:
    app: poc-camel
    component: secrets
type: Opaque
stringData:
  username: "REPLACE_ME"
  password: "REPLACE_ME"
  DATABASE_URL: "jdbc:postgresql://postgres:5432/payments"
  DB_USER: "REPLACE_ME"
  DB_PASSWORD: "REPLACE_ME"
