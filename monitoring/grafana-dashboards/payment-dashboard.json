          "legendFormat": "REVIEW",
          "refId": "B"
        },
        {
          "expr": "rate(fraud_evaluation_total{action=\"APPROVE\"}[5m])",
          "legendFormat": "APPROVE",
          "refId": "C"
        }
      ],
