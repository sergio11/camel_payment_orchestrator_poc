# Environment Configuration - Payment Orchestration Layer

# Application
APP_NAME=poc-camel
QUARKUS_PROFILE=dev

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PAYMENTS=payments.events

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Jaeger
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Database (future)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poc_camel

# Provider Simulation
PROVIDER_A_URL=http://localhost:8081
PROVIDER_B_URL=http://localhost:8082

# Fraud Engine
FRAUD_THRESHOLD_HIGH=80
FRAUD_THRESHOLD_MEDIUM=50
FRAUD_AMOUNT_THRESHOLD=15000